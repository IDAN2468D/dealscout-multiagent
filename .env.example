# DealScout AI Environment Configuration
APP_NAME=dealscout-multiagent
ENVIRONMENT=development
DEBUG=false

# Google Gemini AI Configuration
GOOGLE_API_KEY=
GEMINI_ORCHESTRATOR_MODEL=gemini-3.5-flash-lite
GEMINI_SUBAGENT_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_CONTEXT_CACHE_TTL_SECONDS=3600
LLM_EXECUTION_MODE=auto

# Database, Cache, Search & Streaming (Local Docker host ports)
POSTGRES_USER=dealscout
POSTGRES_PASSWORD=dealscout_pass
POSTGRES_DB=dealscout
DATABASE_URL=postgresql+psycopg://dealscout:dealscout_pass@localhost:5434/dealscout
REDIS_URL=redis://localhost:6381/0
ELASTICSEARCH_URL=http://localhost:9202
ELASTICSEARCH_INDEX=dealscout_products
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=dealscout_promo_policies
KAFKA_BOOTSTRAP_SERVERS=localhost:9095
KAFKA_PRICE_DROP_TOPIC=price-drop-events
KAFKA_DEAL_ALERTS_TOPIC=deal-alerts

# Auth, JWT & Google OAuth2
JWT_SECRET_KEY=dealscout-dev-secret-key-min-32-chars-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=dealscout_refresh_token
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=mock-google-client-id
GOOGLE_CLIENT_SECRET=mock-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8020/api/v1/auth/oauth/google/callback

# Deterministic Commerce & Guardrails
DEFAULT_USD_TO_ILS=3.65
DEFAULT_EUR_TO_ILS=3.95
ISRAEL_VAT_EXEMPTION_USD=75.00
ISRAEL_VAT_RATE=0.18
COUPON_MIN_CROWD_SUCCESS_RATE=0.35
MIN_TRUST_SCORE_BLOCK=70
FAKE_DISCOUNT_SPIKE_THRESHOLD=0.15
MCP_STORE_TIMEOUT_SECONDS=3.0

# Affiliate & Notifications
AFFILIATE_TAG_AMAZON=dealscoutai-20
AFFILIATE_ID_DEFAULT=dealscout
NOTIFY_MODE=mock
TELEGRAM_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# Observability
OTEL_SERVICE_NAME=dealscout-multiagent
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
