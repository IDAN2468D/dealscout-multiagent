{
  "info": {
    "_postman_id": "a73bc67f-960f-426d-829a-dcef1beef3f3",
    "name": "DealScout AI — קולקציית API מלאה (v2.1)",
    "description": "קולקציית Postman מלאה בעברית עבור DealScout AI (dealscout-multiagent v2.1): בדיקת תקינות ושרתי MCP, הרשמה והתחברות (Argon2id + JWT + רוטציית טוקנים + Google OAuth2), פרופיל קונה וארנק מועדונים, חיפוש מבצעים חי ב-SSE (צוות 9 סוכנים על gemini-3.5-flash-lite), זיהוי מוצר מתמונה/קישור (PRO), אופטימיזציית פיצול סל לחיסכון במע\"מ מעל $75 (PRO), אימות קופונים קהילתי, Watchlist והיסטוריית מחירים, שער אישור HITL לרכישה, התראות ירידת מחיר ב-Kafka, ניטור עלויות אדמין והתנתקות.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01. תקינות מערכת ושרתי MCP",
      "item": [
        {
          "name": "בדיקת תקינות שרת (Health Check)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('סטטוס 200 והשרת תקין עם gemini-3.5-flash-lite', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.status).to.eql('healthy');",
                  "  pm.expect(d.model).to.eql('gemini-3.5-flash-lite');",
                  "  pm.expect(d.mcp_servers).to.have.lengthOf(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "רשימת שרתי וכלי MCP (3 שרתים, 10 כלים)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('מחזיר 3 שרתי MCP ו-10 כלים רשומים', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.total_servers).to.eql(3);",
                  "  pm.expect(d.total_tools).to.eql(10);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/mcp/tools",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mcp", "tools"]
            }
          }
        }
      ]
    },
    {
      "name": "02. הרשמה, התחברות ו-OAuth2",
      "item": [
        {
          "name": "הרשמת משתמש חדש",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uniqueEmail = `buyer_${Date.now()}@dealscout.ai`;",
                  "pm.environment.set('user_email', uniqueEmail);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('משתמש נרשם בהצלחה (201) והונפק טוקן אימות', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.verification_token).to.be.a('string').and.not.be.empty;",
                  "  pm.environment.set('verification_token', d.verification_token);",
                  "  pm.environment.set('user_id', d.user_id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\",\n  \"full_name\": \"בודק DealScout\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "אימות כתובת אימייל",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('אימות אימייל הצליח (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().verified).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verification_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/verify-email",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "verify-email"]
            }
          }
        },
        {
          "name": "התחברות (הנפקת JWT + HttpOnly Refresh Cookie)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('התחברות מחזירה access_token תקין', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.access_token).to.be.a('string').and.not.be.empty;",
                  "  pm.environment.set('access_token', d.access_token);",
                  "  pm.environment.set('user_id', d.user_id);",
                  "  pm.environment.set('user_tier', d.tier);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "רענון טוקן (Token Rotation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('רענון טוקן מבצע רוטציה ומנפיק access_token חדש', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.access_token).to.be.a('string').and.not.be.empty;",
                  "  pm.environment.set('access_token', d.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "התחברות Google OAuth2 (סימולציית פיתוח)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Callback של Google OAuth2 מנפיק JWT', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().access_token).to.be.a('string').and.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/oauth/google/callback?code=mock_google_code&email=oauth.user@dealscout.ai",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "oauth", "google", "callback"],
              "query": [
                { "key": "code", "value": "mock_google_code" },
                { "key": "email", "value": "oauth.user@dealscout.ai" }
              ]
            }
          }
        }
      ]
    },
