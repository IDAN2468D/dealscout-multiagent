    {
      "name": "05. התאמה מולטי-מודאלית מתמונה או קישור (PRO)",
      "item": [
        {
          "name": "זיהוי מוצר מקישור URL (200 ל-PRO / 403 ל-FREE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('מחזיר SKU למשתמש PRO או חוסם ב-403 למשתמש FREE', function () {",
                  "  const tier = pm.environment.get('user_tier') || 'FREE';",
                  "  if (tier === 'FREE') {",
                  "    pm.response.to.have.status(403);",
                  "  } else {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().detected_sku).to.eql('SONY-WH1000XM5');",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_url\": \"https://www.amazon.com/dp/B09XS7JWHH\",\n  \"hint_text\": \"Sony WH-1000XM5 Wireless Headphones\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/deals/match-from-image",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "deals", "match-from-image"]
            }
          }
        },
        {
          "name": "זיהוי מוצר מתמונת Base64 (200 ל-PRO / 403 ל-FREE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('מחלץ SKU מתמונה ל-PRO או חוסם ב-403 ל-FREE', function () {",
                  "  const tier = pm.environment.get('user_tier') || 'FREE';",
                  "  if (tier === 'FREE') {",
                  "    pm.response.to.have.status(403);",
